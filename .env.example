# ─────────────────────────────────────────────
# Exegesis Telegram bot token（@BotFather 申請獨立 bot）
# ─────────────────────────────────────────────
EXEGESIS_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# Gemini — paper curation / digest 寫作 / tag 生成 全用這個
# 取得：https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=
# 或 GOOGLE_API_KEY=

# ─────────────────────────────────────────────
# Semantic Scholar（可選，沒 key 走 free tier）
# ─────────────────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=

# ─────────────────────────────────────────────
# Dropbox API（server 端必要、Mac 桌面 client 用戶可省略）
# 跟 Pharos / Anamnesis 共用同一個 Dropbox app（Full Dropbox 權限）
# ─────────────────────────────────────────────
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# ─────────────────────────────────────────────
# Exegesis 排程參數
# ─────────────────────────────────────────────
# EXEGESIS_DOW=5                   # 0=Mon...5=Sat，預設週六
# EXEGESIS_HOUR=21                 # 24h，預設 21:00
# EXEGESIS_DAYS_BACK=14            # 抓近 N 天的 paper
# EXEGESIS_CANDIDATES_LIMIT=25     # 最終候選池大小

# ─────────────────────────────────────────────
# Kobo kepub 同步路徑（Mac local 模式專用，預設 ~/Dropbox/應用程式/Rakuten Kobo）
# ─────────────────────────────────────────────
# DROPBOX_KOBO_LOCAL_PATH=

# ─────────────────────────────────────────────
# 跨 repo dependency 路徑（用於 init_exegesis 自動同步 hash）
# ─────────────────────────────────────────────
# PHAROS_REPO_PATH=/home/yt2epub/yt2epub
# ANAMNESIS_REPO_PATH=/home/yt2epub/anamnesis
