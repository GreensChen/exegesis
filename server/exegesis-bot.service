[Unit]
Description=Exegesis Telegram Bot (AI-driven weekly paper digest)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yt2epub
WorkingDirectory=/home/yt2epub/exegesis
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/home/yt2epub/anamnesis"
EnvironmentFile=/home/yt2epub/exegesis/.env
ExecStart=/usr/bin/python3 -u /home/yt2epub/exegesis/exegesis_bot.py
Restart=on-failure
RestartSec=30
StandardOutput=append:/home/yt2epub/exegesis/exegesis_bot.stdout.log
StandardError=append:/home/yt2epub/exegesis/exegesis_bot.stderr.log

[Install]
WantedBy=multi-user.target
